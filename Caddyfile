# Set APP_DOMAIN in your .env file (e.g. APP_DOMAIN=yourdomain.com).
# Caddy substitutes {$APP_DOMAIN} at startup. The server refuses to start
# if the variable is missing, which is intentional: a deploy without a
# domain would silently serve over HTTP with no certificate.
#
# Example:  APP_DOMAIN=workpilot.co.in
{$APP_DOMAIN} {
    # SSE (Server-Sent Events) stream for QR code / connection status.
    # flush_interval -1 disables buffering entirely for this route so the
    # browser receives QR code events in real time instead of waiting for
    # Caddy's buffer to fill — without this, the QR screen shows
    # "Waiting for QR Code…" forever on the deployed URL.
    @sse path /api/qr-stream
    handle @sse {
        reverse_proxy app:3000 {
            flush_interval -1
        }
    }

    # All other requests — small positive flush_interval for general
    # streaming responses, still fast enough for normal API calls.
    reverse_proxy app:3000 {
        flush_interval 100ms
    }
}
